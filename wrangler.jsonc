{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grokdex",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEjDWXVo9ws84fi6",
  },
  "secrets": {
    "required": ["DATABASE_URL", "TURNSTILE_SECRET", "CRON_SECRET"],
  },
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "kv_namespaces": [
    {
      "binding": "TEMPLATES",
      "id": "f0e09dc10eb648c584f3fb77604ad031",
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "grokdex",
    },
  ],
  "routes": [
    { "pattern": "grokdex.net", "custom_domain": true },
    { "pattern": "www.grokdex.net", "custom_domain": true },
  ],
}
